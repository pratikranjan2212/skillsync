# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & security
.DS_Store
*.pem
*.key
*.cert
*.crt
*.sql
*.dump
*.db
*.sqlite

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env & secrets
.env*
!.env.example

# temporary & local scratch scripts/data
/scratch/
dump.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
