datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @map("password_hash") // Optional to allow GitHub OAuth sign-ups without password
  role          String    @default("student") // "student" | "admin"
  dob           String?
  gender        String?   @default("Male")
  college       String?
  degree        String?
  batch         String?
  bio           String?   @db.Text
  githubUrl     String?   @map("github_url")
  linkedinUrl   String?   @map("linkedin_url")
  portfolioUrl  String?   @map("portfolio_url")
  skills        String[]  @default([])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  evidences     Evidence[]
  passport      Passport?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Evidence {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  type               String    // "project", "coursework", "micro-credential", "competition"
  title              String
  description        String?   @db.Text
  fileUrl            String?   @map("file_url")
  fileHash           String?   @map("file_hash")
  verificationTier   String    @default("flagged-low") @map("verification_tier") // "verified-high", "verified-medium", "flagged-low"
  verificationReason String?   @map("verification_reason") @db.Text
  verificationStage  String    @default("completed") @map("verification_stage")
  verifiedAt         DateTime? @map("verified_at")
  adminOverride      Boolean?  @default(false) @map("admin_override")
  claimedSkills      String[]  @map("claimed_skills")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("evidences")
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model Passport {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  studentId      String   @unique @map("student_id")
  isPublic       Boolean  @default(true) @map("is_public")
  shareToken     String   @unique @map("share_token")
  credentialHash String   @map("credential_hash")
  issuer         String   @default("SkillSync Verifiable Credential Engine")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passports")
}

model Opportunity {
  id             String   @id @default(cuid())
  title          String
  company        String
  location       String
  stipend        String?
  type           String   @default("Internship")
  description    String?  @db.Text
  requiredSkills String[] @map("required_skills")
  externalId     String?  @unique @map("external_id")
  source         String   @default("Direct") // "Adzuna", "Jooble", "Remotive", "Arbeitnow", "Jobicy", "Direct"
  url            String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("opportunities")
}

model FairnessAudit {
  id                 String   @id @default(cuid())
  timestamp          DateTime @default(now())
  excludedParameters String[] @map("excluded_parameters")
  sampleSize         Int      @map("sample_size")
  parityScore        Float    @map("parity_score")
  notes              String?  @db.Text

  @@map("fairness_audits")
}
