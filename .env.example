# ==============================================================================
# SkillSync - Secure Environment Configuration Template
# ==============================================================================
# In production, set these secrets in your deployment environment (e.g. Vercel,
# AWS Secrets Manager, Railway). Never commit .env files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Security Requirements:
# - Always enforce SSL: append ?sslmode=require&supavisor=true
# - Restrict database access to your application server IP range or private VPC
# - Use the Supabase Session/Transaction Pooler for serverless deployments
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&supavisor=true"

# ------------------------------------------------------------------------------
# 2. NextAuth.js / Auth Core Secrets
# ------------------------------------------------------------------------------
# Security Requirements:
# - Generate a cryptographically secure 32+ character key using: openssl rand -hex 32
# - Set NEXTAUTH_URL to your canonical HTTPS production domain
# ------------------------------------------------------------------------------
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. OAuth Providers (GitHub)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ------------------------------------------------------------------------------
# 4. Supabase Storage & Service Key
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY is a server-side superuser key. NEVER expose to frontend.
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# 5. Evidence Verification & Ingestion APIs (Optional / Server-Only)
# ------------------------------------------------------------------------------
OCR_SPACE_API_KEY=""
GITHUB_TOKEN=""
LINKEDIN_SCRAPER_API_KEY=""
APIFY_API_KEY=""
HUGGINGFACE_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Cron Job Authorization Secret
# ------------------------------------------------------------------------------
# Required for triggering /api/cron/ingest. Pass header: Authorization: Bearer <CRON_SECRET>
# ------------------------------------------------------------------------------
CRON_SECRET=""
