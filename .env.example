# ==============================================================================
# SkillSync - Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skillsync?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-nextauth-secret-skillsync-32-chars-long"
AUTH_SECRET="dev-nextauth-secret-skillsync-32-chars-long"
AUTH_TRUST_HOST="true"

# GitHub OAuth Application (for User Sign-In)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Supabase Storage & Database (Optional)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Evidence Verification API Keys (Optional)
OCR_SPACE_API_KEY=""
GITHUB_TOKEN=""

# Job Scrapers & Ingestion Providers (Optional)
LINKEDIN_SCRAPER_API_KEY=""
APIFY_API_KEY=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
JOOBLE_API_KEY=""

# AI Matching & Inference (Optional)
HUGGINGFACE_API_KEY=""

# Ingestion Cron Secret
CRON_SECRET="skillsync-cron-secret-token"
