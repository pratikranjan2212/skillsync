# ==============================================================================
# SkillSync - Secure Environment Configuration Template
# ==============================================================================
# In production, set these secrets in your deployment environment (e.g. Vercel,
# AWS Secrets Manager, Railway). Never commit .env files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# SkillSync automatically supports BOTH standard variable names and Vercel/Supabase
# integration variable names (e.g. STORAGE_POSTGRES_PRISMA_URL).
#
# Standard format:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&supavisor=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Vercel / Supabase Storage Integration format (Supported automatically):
# STORAGE_POSTGRES_PRISMA_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&supavisor=true"
# STORAGE_POSTGRES_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# STORAGE_POSTGRES_URL_NON_POOLING="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# STORAGE_POSTGRES_HOST="aws-0-[REGION].pooler.supabase.com"
# STORAGE_POSTGRES_USER="postgres.[PROJECT_REF]"
# STORAGE_POSTGRES_PASSWORD="[DB_PASSWORD]"
# STORAGE_POSTGRES_DATABASE="postgres"

# ------------------------------------------------------------------------------
# 2. NextAuth.js / Auth Core Secrets
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32+ character key: openssl rand -hex 32
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. OAuth Providers (GitHub, Google, LinkedIn)
# ------------------------------------------------------------------------------
# GitHub OAuth (Callback: https://your-domain.com/api/auth/callback/github)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth (Callback: https://your-domain.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# LinkedIn OAuth (Callback: https://your-domain.com/api/auth/callback/linkedin)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# ------------------------------------------------------------------------------
# 4. Supabase Storage & API Keys
# ------------------------------------------------------------------------------
# SkillSync automatically supports standard and STORAGE_ prefixed keys:
#
# Standard format:
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Vercel / Supabase Storage Integration format (Supported automatically):
# STORAGE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# STORAGE_SUPABASE_SERVICE_ROLE_KEY=""
# STORAGE_SUPABASE_SECRET_KEY=""
# STORAGE_SUPABASE_ANON_KEY=""
# STORAGE_SUPABASE_PUBLISHABLE_KEY=""
# STORAGE_SUPABASE_JWT_SECRET=""
# NEXT_PUBLIC_STORAGE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_STORAGE_SUPABASE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------------------------
# 5. Evidence Verification & Ingestion APIs (Optional / Server-Only)
# ------------------------------------------------------------------------------
OCR_SPACE_API_KEY=""
GITHUB_TOKEN=""
LINKEDIN_SCRAPER_API_KEY=""
APIFY_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Cron Job Authorization Secret
# ------------------------------------------------------------------------------
# Required for triggering /api/cron/ingest. Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 7. Email (Gmail SMTP — OTP Verification)
# ------------------------------------------------------------------------------
# Used to send 6-digit OTP codes to users who register with email + password.
# Use a Gmail account with 2FA enabled and generate an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_FROM="yourapp@gmail.com"
EMAIL_APP_PASSWORD=""
